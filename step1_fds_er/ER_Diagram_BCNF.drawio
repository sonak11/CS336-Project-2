s"></Array></mxGeometry></mxCell><mxCell id="c316" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=14;startSize=14;strokeWidth=1.5;strokeColor=#222222;exitX=0.500000;exitY=1.000000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.500000;entryY=0.000000;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=11;fontStyle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c116" target="c126"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c317" value="CS336 Project 2 · HMDA 2017 New Jersey · Normalized (BCNF) ER Diagram" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="2200" height="40" as="geometry"/></mxCell><mxCell id="c318" value="Crow&#x27;s foot (Oracle) notation · PK = primary key (underlined) · FK = foreign key (FK1, FK2… mark the columns of one composite foreign key) · U = the ten location columns are UNIQUE together · FD numbers refer to functional_dependencies.txt" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="62" width="2300" height="50" as="geometry"/></mxCell><mxCell id="c319" value="Notation key" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1388" width="300" height="26" as="geometry"/></mxCell><mxCell id="c320" value="" style="endArrow=ERmandOne;startArrow=none;endFill=0;endSize=14;html=1;strokeWidth=1.5;strokeColor=#222222;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1428" as="sourcePoint"/><mxPoint x="170" y="1428" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c321" value="exactly one" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="185" y="1417" width="200" height="24" as="geometry"/></mxCell><mxCell id="c322" value="" style="endArrow=ERzeroToOne;startArrow=none;endFill=0;endSize=14;html=1;strokeWidth=1.5;strokeColor=#222222;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1460" as="sourcePoint"/><mxPoint x="170" y="1460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c323" value="zero or one" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="185" y="1449" width="200" height="24" as="geometry"/></mxCell><mxCell id="c324" value="" style="endArrow=ERoneToMany;startArrow=none;endFill=0;endSize=14;html=1;strokeWidth=1.5;strokeColor=#222222;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1492" as="sourcePoint"/><mxPoint x="170" y="1492" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c325" value="one or many" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="185" y="1481" width="200" height="24" as="geometry"/></mxCell><mxCell id="c326" value="" style="endArrow=ERzeroToMany;startArrow=none;endFill=0;endSize=14;html=1;strokeWidth=1.5;strokeColor=#222222;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1524" as="sourcePoint"/><mxPoint x="170" y="1524" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c327" value="zero or many" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="185" y="1513" width="200" height="24" as="geometry"/></mxCell><mxCell id="c328" value="Where each functional dependency lives: application FD1 · location FD2, FD3 · agency FD4 · loan_type FD5 · property_type FD6 · loan_purpose FD7 · owner_occupancy FD8 · preapproval FD9 · action_taken FD10 · msa_md FD11 · state FD12 · county FD13 · applicant_ethnicity FD14 · co_applicant_ethnicity FD15 · applicant_sex FD16 · co_applicant_sex FD17 · purchaser_type FD18 · hoepa_status FD19 · lien_status FD20 · null_columns FD21 · applicant_race FD22 · co_applicant_race FD24 · race FD23, FD25 · application_denial FD26 · denial_reason FD27. Every table is in BCNF, every dependency is preserved, and the decomposition is lossless.&lt;br&gt;&lt;br&gt;race is one table shared by applicant_race and co_applicant_race (first normal form turns the 20 race columns into one race column). Ethnicity and sex keep their original columns, so applicant and co-applicant each have their own table; only the co-applicant tables include code 5 (No co-applicant). applicant_race / co_applicant_race / application_denial put the repeating race 1–5 and denial reason 1–3 columns into first normal form; race_number and denial_reason_number keep the original slot. Every application reports at least one applicant and one co-applicant race (8 = no co-applicant), so those two are one or many. msamd and county_code are blank for some locations, so those parents are zero or one. null_columns holds the three columns that are blank in every row and has no relationships." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="1388" width="1950" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>